# ============================================================
# TECHINS Work Portal — Required Environment Variables
# Copy this file to .env and fill in your actual values.
# On Vercel: add each variable in Settings → Environment Variables
# ============================================================

# ── REQUIRED ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# MongoDB Atlas connection string
# Format: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?appName=AppName
MONGODB_URI=

# ══════════════════════════════════════════════════════════════
# CEO ACCOUNT (Direct Login - No Registration Required)
# ══════════════════════════════════════════════════════════════
# CRITICAL: Set these in Vercel environment variables for production!
# Only this email can log in as CEO. No one can register as CEO.
# 
# CEO_EMAIL: The email address that can log in as CEO
# CEO_PASSWORD: (optional) Plaintext CEO password. On first startup, the
#   server generates CEO_PASSWORD_HASH from it automatically (cost 12) and
#   saves it to .env. If CEO_PASSWORD_HASH is already set, it is used as-is.
# CEO_PASSWORD_HASH: Bcrypt hash of the CEO password (cost factor 12).
#   Generate with: node scripts/generate-ceo-hash.js "your-password-here"
# CEO_NAME: Display name for the CEO account
# 
# SECURITY:
# - CEO authentication happens via environment variables ONLY (no database)
# - Any user documents with CEO email are automatically removed from database
# - CEO cannot register through public signup
# - CEO tokens work only on CEO-specific routes
CEO_EMAIL=ceo@techins.com
CEO_PASSWORD_HASH=
CEO_NAME=TECHINS CEO

# ══════════════════════════════════════════════════════════════
# CORS CONFIGURATION (REQUIRED for frontend-backend communication)
# ══════════════════════════════════════════════════════════════
# Comma-separated list of allowed frontend origins (no trailing slashes)
# Example: https://your-frontend.vercel.app,https://another-domain.com
CORS_ORIGINS=https://technis-work-portal-05-35bp.vercel.app

# ── OPTIONAL ─────────────────────────────────────────────────
# MongoDB database name (default: techins)
MONGODB_DB_NAME=techins

# ── TASK REVIEW WORKFLOW ──────────────────────────────────────
# Length of the resubmission window, in hours, measured on the SERVER clock
# from the moment an admin requests a revision. Default 24.
# Production must leave this at 24; the automated tests start a throwaway
# server with a tiny value to exercise expiry without waiting (see
# server/test/task-review.test.js). There is no code path that overrides it.
RESUBMISSION_WINDOW_HOURS=24

# Minimum characters an admin must write when requesting a revision.
# Applies to POST /api/tasks/review too, so the legacy endpoint cannot
# create a revision without usable feedback.
REVISION_FEEDBACK_MIN_CHARS=10

# Hours a student must wait between two reminders for the same task.
# Enforced server-side, so a double click, a reload or a second tab cannot
# produce duplicate reminders.
REMINDER_COOLDOWN_HOURS=12

# ── REQUIRED FOR VERCEL CRON ────────────────────────────────
# Secret for GET/POST /api/cron/expire-resubmissions, which is declared in
# server/vercel.json ("crons": hourly). Vercel sends it as
#   Authorization: Bearer $CRON_SECRET
# If this is not set the endpoint answers 503 and explains why — it never runs
# unprotected. Expiry still happens lazily on every Task Manager read, so the
# cron only makes notifications timely, it is not required for correctness.
CRON_SECRET=

# Your frontend Vercel URL — used for CORS and email links
# DEPRECATED: Use CORS_ORIGINS instead (kept for backward compatibility)
# Can be comma-separated for multiple origins
FRONTEND_URL=https://your-frontend.vercel.app

# Same as FRONTEND_URL — used in email notification links
APP_URL=https://your-frontend.vercel.app

# Resend.dev email notifications (leave empty to skip emails)
RESEND_API_KEY=
EMAIL_FROM=TECHINS <onboarding@resend.dev>

# Default admin account (auto-created on first startup)
# Optional: Only if you need a separate admin account (different from CEO)
ADMIN_EMAIL=admin@techins.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=TECHINS Admin

# Default manager account (auto-created on first startup)
# STRONGLY RECOMMENDED: Set custom values for production
MANAGER_EMAIL=manager@techins.com
MANAGER_PASSWORD=Manager@123
MANAGER_NAME=TECHINS Manager
MANAGER_DEPARTMENT=Techins

# ── LOCAL DEV ONLY ────────────────────────────────────────────
# These are ignored on Vercel (Vercel injects env vars directly)
PORT=5000
NODE_ENV=development

# ── GOOGLE DRIVE STORAGE ──────────────────────────────────
GOOGLE_DRIVE_ROOT_FOLDER_ID=18F5yTfw0ceaZX1z3phu74cg2dJGo47-0
# Preferred (OAuth refresh token for the folder owner):
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Alternative (service account) for Shared Drives:
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_UPLOAD_MAX_BYTES=5242880
# Test/dev only: use a local mock Drive instead of calling the API
GOOGLE_DRIVE_MOCK=
