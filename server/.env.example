# ============================================================
# TECHINS Work Portal — Required Environment Variables
# Copy this file to .env and fill in your actual values.
# On Vercel: add each variable in Settings → Environment Variables
# ============================================================

# ── REQUIRED ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# MongoDB Atlas connection string
# Format: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?appName=AppName
MONGODB_URI=

# ── OPTIONAL ─────────────────────────────────────────────────
# MongoDB database name (default: techins)
MONGODB_DB_NAME=techins

# Your frontend Vercel URL — used for CORS and email links
# Can be comma-separated for multiple origins
FRONTEND_URL=https://your-frontend.vercel.app

# Same as FRONTEND_URL — used in email notification links
APP_URL=https://your-frontend.vercel.app

# Resend.dev email notifications (leave empty to skip emails)
RESEND_API_KEY=
EMAIL_FROM=TECHINS <onboarding@resend.dev>

# ── LOCAL DEV ONLY ────────────────────────────────────────────
# These are ignored on Vercel (Vercel injects env vars directly)
PORT=5000
NODE_ENV=development
