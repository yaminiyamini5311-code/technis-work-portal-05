# ============================================================
# TECHINS Work Portal — Required Environment Variables
# Copy this file to .env and fill in your actual values.
# On Vercel: add each variable in Settings → Environment Variables
# ============================================================

# ── REQUIRED ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# MongoDB Atlas connection string
# Format: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?appName=AppName
MONGODB_URI=

# ══════════════════════════════════════════════════════════════
# CEO ACCOUNT (Direct Login - No Registration Required)
# ══════════════════════════════════════════════════════════════
# CRITICAL: Set these in Vercel environment variables for production!
# Only this email can log in as CEO. No one can register as CEO.
# 
# CEO_EMAIL: The email address that can log in as CEO
# CEO_PASSWORD_HASH: Bcrypt hash of the CEO password (cost factor 12)
#   Generate with: node scripts/generate-ceo-hash.js "your-password-here"
# CEO_NAME: Display name for the CEO account
# 
# SECURITY:
# - CEO authentication happens via environment variables ONLY (no database)
# - Any user documents with CEO email are automatically removed from database
# - CEO cannot register through public signup
# - CEO tokens work only on CEO-specific routes
CEO_EMAIL=ceo@techins.com
CEO_PASSWORD_HASH=
CEO_NAME=TECHINS CEO

# ══════════════════════════════════════════════════════════════
# CORS CONFIGURATION (REQUIRED for frontend-backend communication)
# ══════════════════════════════════════════════════════════════
# Comma-separated list of allowed frontend origins (no trailing slashes)
# Example: https://your-frontend.vercel.app,https://another-domain.com
CORS_ORIGINS=https://technis-work-portal-05-35bp.vercel.app

# ── OPTIONAL ─────────────────────────────────────────────────
# MongoDB database name (default: techins)
MONGODB_DB_NAME=techins

# Your frontend Vercel URL — used for CORS and email links
# DEPRECATED: Use CORS_ORIGINS instead (kept for backward compatibility)
# Can be comma-separated for multiple origins
FRONTEND_URL=https://your-frontend.vercel.app

# Same as FRONTEND_URL — used in email notification links
APP_URL=https://your-frontend.vercel.app

# Resend.dev email notifications (leave empty to skip emails)
RESEND_API_KEY=
EMAIL_FROM=TECHINS <onboarding@resend.dev>

# Default admin account (auto-created on first startup)
# Optional: Only if you need a separate admin account (different from CEO)
ADMIN_EMAIL=admin@techins.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=TECHINS Admin

# Default manager account (auto-created on first startup)
# STRONGLY RECOMMENDED: Set custom values for production
MANAGER_EMAIL=manager@techins.com
MANAGER_PASSWORD=Manager@123
MANAGER_NAME=TECHINS Manager
MANAGER_DEPARTMENT=Techins

# ── LOCAL DEV ONLY ────────────────────────────────────────────
# These are ignored on Vercel (Vercel injects env vars directly)
PORT=5000
NODE_ENV=development
