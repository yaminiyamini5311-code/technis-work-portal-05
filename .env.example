# Local development defaults
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173
RESEND_API_KEY=
EMAIL_FROM=TECHINS <onboarding@resend.dev>

# Allowed student emails for registration (comma or newline separated)
# For production, set this in Render dashboard
# For development, use server/allowed-students.txt (gitignored)
ALLOWED_STUDENT_EMAILS=

# ─── Google Drive file storage (optional) ───────────────────────────────────
# When these three are absent the app behaves exactly as before and the Drive
# upload endpoints answer 503. They are BACKEND-ONLY: never expose them to the
# frontend (no VITE_ prefix) and never commit real values.
#
# The service account MUST be a member of the Shared Drive that contains the
# parent folder - a service account in a personal My Drive has no storage
# quota and every upload fails.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the newlines as literal \n sequences; the server expands them.
GOOGLE_PRIVATE_KEY=
# Folder ID of the TECHINS-PORTAL parent folder in the Shared Drive.
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# Optional. Default scope is the minimal per-file scope (drive.file), which is
# enough because every file here is app-created. Widen to
# https://www.googleapis.com/auth/drive only if you ever need access to files
# the app did not create.
GOOGLE_DRIVE_SCOPES=

# Optional. IANA timezone used for the date in exported Excel filenames and
# for displayed upload timestamps. Falls back to UTC when unset or invalid.
APP_TIMEZONE=
